        <mxCell id="6" value="&lt;b&gt;1. Cadastro de endereço&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;Rua, número, bairro&lt;br&gt;cidade, UF e CEP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;fontSize=13;" parent="1" vertex="1">
