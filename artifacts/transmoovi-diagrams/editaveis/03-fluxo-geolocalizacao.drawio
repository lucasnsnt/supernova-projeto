        <mxCell id="11" value="&lt;b&gt;GeocodingService&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;Só resolve coordenadas ausentes&lt;br&gt;confidence ≥ 0,6 • país BR&lt;br&gt;limites válidos de lat/lng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;fontSize=13;" parent="1" vertex="1">
