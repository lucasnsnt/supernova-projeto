        </mxCell>
        <mxCell id="12" value="&lt;b&gt;4. TripPlanningService&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;Base operacional do motorista&lt;br&gt;casas + instituições&lt;br&gt;capacidade e horário acadêmico&lt;br&gt;IDA: casa → instituição&lt;br&gt;VOLTA: instituição → casa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontColor=#172033;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="470" y="500" width="360" height="210" as="geometry" />
