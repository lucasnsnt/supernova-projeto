        <mxCell id="7" value="&lt;b&gt;2. Prévia no mapa&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;POST /api/geocoding/preview&lt;br&gt;AddressMap / Google Maps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontColor=#172033;fontSize=13;" parent="1" vertex="1">
