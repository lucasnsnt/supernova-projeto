        </mxCell>
        <mxCell id="26" value="&lt;b&gt;Guardas de início&lt;/b&gt;&lt;br&gt;Motorista aprovado • nenhuma outra viagem IN_PROGRESS • ocorrência não vazia • rota viável&lt;br&gt;Fora da janela inclusiva de 30 min antes/depois, é obrigatório acknowledge explícito." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FDECEC;strokeColor=#C2413B;dashed=1;fontColor=#172033;" parent="1" vertex="1">
