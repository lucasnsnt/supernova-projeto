        </mxCell>
        <mxCell id="24" value="&lt;b&gt;Rastreamento&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#596579&quot;&gt;posição 1:1 da viagem&lt;br&gt;concluir paradas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFFFFF;strokeColor=#15803D;strokeWidth=2;fontColor=#172033;fontSize=13;" parent="1" vertex="1">
