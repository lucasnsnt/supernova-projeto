        <mxCell id="28" value="&lt;b&gt;Legenda relacional&lt;/b&gt;&lt;br&gt;PK = chave primária • FK = chave estrangeira • UQ = unicidade&lt;br&gt;1 = obrigatório e único • 0..1 = opcional • 0..* = muitos&lt;br&gt;Setas apontam para a entidade referenciada.&lt;br&gt;Domínios são agrupamentos de leitura; não são schemas PostgreSQL." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#EEF1F5;strokeColor=#475467;dashed=1;fontColor=#172033;" parent="1" vertex="1">
          <mxGeometry x="1420" y="1110" width="685" height="250" as="geometry" />
        </mxCell>
        <mxCell id="29" value="&lt;b&gt;Nota de histórico&lt;/b&gt;&lt;br&gt;V8 preserva confirmações/viagens históricas, liga ocorrências inequívocas&lt;br&gt;a rotas recorrentes e mantém casos ambíguos em NEEDS_ATTENTION." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF4E5;strokeColor=#B45309;dashed=1;fontColor=#172033;" parent="1" vertex="1">
          <mxGeometry x="1420" y="1400" width="685" height="135" as="geometry" />
