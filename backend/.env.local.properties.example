# Copie para .env.local.properties (ignorado pelo Git).
# Use credenciais exclusivas de desenvolvimento, nunca as de produção.
# Descomente para criar um administrador no primeiro início local.
# app.local-admin.email=admin@example.test
# app.local-admin.password=defina-uma-senha-local

# Fixe estes valores para que banco e sessões não mudem conforme o diretório
# usado para iniciar a aplicação. Gere um JWT_SECRET exclusivo para sua máquina.
# JWT_SECRET=gere-com-openssl-rand-base64-48
# LOCAL_DATABASE_PATH=/caminho/absoluto/para/supernova-projeto/.local/supernova

# Para usar PostgreSQL local no lugar do H2, configure as três variáveis abaixo.
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/supernova_local
# DATABASE_USERNAME=supernova_local
# DATABASE_PASSWORD=senha-local-exclusiva

# Habilite para localizar endereços com a API pública do openrouteservice.
# ORS_GEOCODING_ENABLED=true
# ORS_API_KEY=chave-exclusiva-de-desenvolvimento
